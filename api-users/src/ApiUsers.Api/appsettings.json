{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "api-users",
    "Audience": "api-users-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
