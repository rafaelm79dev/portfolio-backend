# Copy this file to ".env" (it is ignored by git) and set real passwords.
# Docker Compose needs both variables defined, even if you only start one of the two databases.

# SQL Server password policy: at least 8 characters, with upper case, lower case, a number and a symbol.
MSSQL_SA_PASSWORD=

# PostgreSQL (only used by the optional "postgres" profile).
POSTGRES_PASSWORD=
